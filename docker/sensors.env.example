# Copy to docker/sensors.env, fill in your real device identities, then run:
#   ./docker/run.sh build
#   ./docker/run.sh
# run.sh reads this file automatically. Shell environment overrides still work.
# For Compose: source docker/sensors.env before the documented compose command.

export LIVOX_LIDAR_IP="${LIVOX_LIDAR_IP:-}"
export ORBBEC_CAMERA_COUNT="${ORBBEC_CAMERA_COUNT:-3}"
export USE_ORBBEC_CAMERA="${USE_ORBBEC_CAMERA:-true}"
export ORBBEC_SERIAL_NUMBER="${ORBBEC_SERIAL_NUMBER:-}"
export ORBBEC_SERIAL_NUMBER_2="${ORBBEC_SERIAL_NUMBER_2:-}"
export ORBBEC_SERIAL_NUMBER_3="${ORBBEC_SERIAL_NUMBER_3:-}"
export ORBBEC_CAMERA_NAME="${ORBBEC_CAMERA_NAME:-camera}"
export ORBBEC_CAMERA_NAME_2="${ORBBEC_CAMERA_NAME_2:-camera_2}"
export ORBBEC_CAMERA_NAME_3="${ORBBEC_CAMERA_NAME_3:-camera_3}"

# Use the full /dev/serial/by-id/... path of each device, not /dev/ttyACM0/1.
export USE_GX5_DRIVER="${USE_GX5_DRIVER:-true}"
export GX5_PORT_1="${GX5_PORT_1:-}"
export GX5_PORT_2="${GX5_PORT_2:-}"
